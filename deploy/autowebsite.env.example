# Copy to /etc/autowebsite/autowebsite.env, replace every example value, then
# chmod 600 it. This is read by systemd, not committed to Git.
AUTOWEBSITE_ADMIN_USERNAME=admin
AUTOWEBSITE_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
AUTOWEBSITE_SESSION_SECRET=replace-with-a-long-random-secret
AUTOWEBSITE_SECURE_COOKIES=true

AUTOWEBSITE_DATABASE_PATH=/srv/autowebsite/state/data/autowebsite.db
AUTOWEBSITE_REPOSITORIES_ROOT=/srv/autowebsite/state/repos
AUTOWEBSITE_DEFAULT_WEBSITE_DIRECTORY=/srv/autowebsite/state/repos/active-site
AUTOWEBSITE_STAGING_ROOT=/srv/autowebsite/state/staging
AUTOWEBSITE_WORKSPACES_ROOT=/srv/autowebsite/state/workspaces
AUTOWEBSITE_PUBLISHED_ROOT=/srv/autowebsite/state/published
AUTOWEBSITE_UPLOADS_ROOT=/srv/autowebsite/state/uploads
AUTOWEBSITE_LOGS_ROOT=/srv/autowebsite/state/logs

# Keep false until `codex login` (or the production API-key authentication
# method) has been completed as the autowebsite account.
AUTOWEBSITE_AGENT_ENABLED=false
AUTOWEBSITE_AGENT_COMMAND=codex
AUTOWEBSITE_AGENT_MODEL=gpt-5.6-terra
AUTOWEBSITE_AGENT_TIMEOUT_SECONDS=900

AUTOWEBSITE_UPLOAD_MALWARE_SCAN_ENABLED=true
AUTOWEBSITE_UPLOAD_MALWARE_SCAN_COMMAND=clamscan
AUTOWEBSITE_MAX_UPLOAD_BYTES=10485760
